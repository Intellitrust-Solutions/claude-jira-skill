# Jira API 憑證（必填）
# 申請 token: https://id.atlassian.com/manage-profile/security/api-tokens

JIRA_BASE_URL=https://your-workspace.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token_here

# 工作日（選填）— 給 due date 推算用
# 0=週一, 1=週二, 2=週三, 3=週四, 4=週五, 5=週六, 6=週日
# 預設 0,1,2,3,4（週一到週五）
# Tue-Sat 設定範例：
# JIRA_WORKING_DAYS=1,2,3,4,5
